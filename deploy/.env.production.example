# Copy to deploy/.env.production on the server and replace every placeholder.
CADDY_DOMAIN=crm.example.ru
CADDY_EMAIL=ops@example.ru
MARIADB_DATABASE=servio_crm
MARIADB_USER=crm_user
MARIADB_PASSWORD=generate_a_long_unique_password
MARIADB_ROOT_PASSWORD=generate_another_long_unique_password
DATABASE_URL=mysql://crm_user:generate_a_long_unique_password@db:3306/servio_crm
NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://crm.example.ru
COOKIE_SECURE=true
JWT_ACCESS_SECRET=generate_a_long_random_value
JWT_REFRESH_SECRET=generate_a_different_long_random_value
ENCRYPTION_KEY=hex_encoded_32_byte_key
TELEGRAM_BOT_TOKEN=replace_before_production
TELEGRAM_BOT_USERNAME=TMP_BAZIS_BOT
TELEGRAM_REGISTRATION_URL=https://crm.example.ru/register
# Optional: only Telegram traffic is sent through this proxy.
# TELEGRAM_PROXY_URL=socks5://login:password@proxy-host:1080
