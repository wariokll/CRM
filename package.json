{
  "name": "bazis-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "powershell -ExecutionPolicy Bypass -File ./start-crm.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./stop-crm.ps1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\" \"backend/prisma/**/*.{prisma,sql}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"backend/src/**/*.ts\"",
    "lint": "eslint src backend/src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  }
}
